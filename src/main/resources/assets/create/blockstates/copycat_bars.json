{
  "multipart": [
    { "apply": { "model": "create:copycat_bars_post" } },
    { "when": { "north": true }, "apply": { "model": "create:copycat_bars_side" } },
    { "when": { "east": true }, "apply": { "model": "create:copycat_bars_side", "y": 90 } },
    { "when": { "south": true }, "apply": { "model": "create:copycat_bars_side", "y": 180 } },
    { "when": { "west": true }, "apply": { "model": "create:copycat_bars_side", "y": 270 } }
  ]
}
